rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 업로드 사진: 누구나 읽기(사이트 노출), 관리자만 업로드
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'gniusk614@nate.com';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
